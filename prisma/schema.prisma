// SalesIQ — persistent backend, Phase 1.
//
// Core models (Tenant, Branch, User, Session, RolePermission, Lead) are
// wired to real API routes this phase. Every other model below mirrors an
// existing localStorage-backed store in src/core/data/*.ts or
// src/core/store/*.ts and is a schema-only placeholder — present so the
// schema is holistic, not yet read/written by any route. See the migration
// plan for the phased rollout.
//
// Tenant-scoping convention applied throughout: every tenant-owned model
// carries `tenantId` + an index on it, and natural keys are composite
// (`@@unique([tenantId, x])`), never a bare global unique — the one thing
// the localStorage-only app never had to model, since it was effectively
// single-tenant per browser.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Core — wired this phase
// ---------------------------------------------------------------------

enum UserRole {
  Owner
  Admin
  Manager
  // Template Builder / Deal Room design role — can build and publish
  // DealRoomTemplates but isn't granted the broader Manager permission set.
  Designer
  Salesperson
  Viewer
}

enum UserStatus {
  active
  invited
  suspended
}

enum LeadStatus {
  new
  contacted
  qualified
  won
  lost
}

enum BrochureTemplate {
  Modern
  Luxury
  Minimal
}

enum BrochureTheme {
  Light
  Dark
  Auto
  Brand
}

enum BrochureStatus {
  Draft
  Published
  Archived
}

enum BrochureEventKind {
  View
  Scan
  Click
  LeadSubmitted
}

enum DealRoomTemplateStatus {
  Draft
  Published
  Archived
}

enum DealRoomStatus {
  Draft
  Published
  Archived
}

enum DealRoomTheme {
  Light
  Dark
  Auto
  Brand
}

enum DealRoomAccessMode {
  PublicLink
  Restricted
}

enum DealRoomEventKind {
  View
  Scan
  Click
  WidgetInteraction
  Download
  Share
  ProposalAccepted
  TaskCompleted
  SignatureRequested
  SignatureSigned
}

enum DealRoomTaskStatus {
  Open
  InProgress
  Done
}

enum DealRoomApprovalStepStatus {
  Pending
  Approved
  Rejected
}

enum DealRoomSignatureStatus {
  Requested
  Signed
  Declined
}

model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  legalName       String   @default("")
  logoGlyph       String   @default("◈")
  logoUrl         String   @default("")
  tagline         String   @default("")
  defaultLanguage String   @default("en")
  defaultCurrency String   @default("USD")
  timezone        String   @default("UTC")
  address         String   @default("")
  workingHours    Json
  businessUnits   String[]

  // Platform-operator view (src/core/data/platformTenants.ts) — folded
  // into Tenant rather than a parallel table, so the admin console's
  // headline numbers and this row can never drift apart once wired.
  plan     String @default("Starter")
  seats    Int    @default(1)
  mrr      Decimal @default(0) @db.Decimal(12, 2)
  health   String @default("healthy")
  vertical String @default("real-estate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches        Branch[]
  users           User[]
  sessions        Session[]
  rolePermissions RolePermission[]
  leads           Lead[]
  brochures       Brochure[]
  brochureEvents  BrochureEvent[]
  brochureAssets  BrochureAsset[]

  dealRoomTemplates        DealRoomTemplate[]
  dealRoomTemplateVersions DealRoomTemplateVersion[]
  dealRooms                DealRoom[]
  dealRoomAssets           DealRoomAsset[]
  dealRoomEvents           DealRoomEvent[]
  dealRoomTasks            DealRoomTask[]
  dealRoomMessages         DealRoomMessage[]
  dealRoomApprovalSteps    DealRoomApprovalStep[]
  dealRoomSignatureRequests DealRoomSignatureRequest[]

  /// TODO(pass-2): src/core/data/knowledgeBase.ts
  knowledgeEntries KnowledgeEntry[]
  /// TODO(pass-2): src/core/data/tenantAuditLog.ts
  tenantAuditEntries TenantAuditEntry[]
  /// TODO(pass-2): src/core/data/notifications.ts
  notifications Notification[]
  /// TODO(pass-2): src/core/data/featureFlags.ts
  featureFlags FeatureFlag[]
  /// TODO(pass-2): src/core/data/ssoSettings.ts
  ssoSettings SsoSettings?
  /// TODO(pass-2): src/core/data/aiSettingsShared.ts
  aiSettings AiSettings?
  /// TODO(pass-2): src/core/data/integrations.ts
  integrationSettings IntegrationSettings?
  /// TODO(pass-2): src/core/data/billingSettings.ts
  billingSettings BillingSettings?
  /// TODO(pass-2): src/core/data/subscription.ts
  subscription Subscription?
  /// TODO(pass-2): src/core/data/customPacks.ts
  customPacks CustomPack[]
  /// TODO(pass-2): src/core/store/packs.ts
  packDrafts PackDraft[]

  @@index([slug])
}

model Branch {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String   @default("")
  lat          Float?
  lng          Float?
  phone        String   @default("")
  status       String   @default("active")
  workingHours Json
  teamSize     Int      @default(0)
  displays     Int      @default(0)
  companions   Int      @default(0)
  createdAt    DateTime @default(now())

  users User[]
  leads Lead[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         UserRole
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status       UserStatus @default(invited)
  // Toggle only — no TOTP secret yet, see the PILOT-MODE AUTH comment in
  // core/data/auth.ts for exactly what this does and doesn't secure.
  mfaEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  device       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions      Session[]
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads  Lead[] @relation("LeadCreator")
  createdBrochures Brochure[]

  createdDealRoomTemplates DealRoomTemplate[]
  authoredDealRoomVersions DealRoomTemplateVersion[]
  createdDealRooms         DealRoom[]
  assignedDealRoomTasks    DealRoomTask[]
  dealRoomMessages         DealRoomMessage[]
  dealRoomApprovalSteps    DealRoomApprovalStep[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

model Session {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         UserRole
  capabilityId String
  granted      Boolean

  @@unique([tenantId, role, capabilityId])
  @@index([tenantId, role])
}

model Lead {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name  String
  phone String @default("")
  email String @default("")
  notes String @default("")

  packId    String
  packLabel String
  itemName  String
  price     Decimal @db.Decimal(14, 2)
  currency  String  @db.Char(3)
  score     Int

  status       LeadStatus @default(new)
  assignedToId String?
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?      @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  followUpAt DateTime?
  // GDPR redact (src/core/store/leads.ts redactLeadPII) still writes the
  // literal string "Redacted" to `name` for compatibility with
  // SecurityCompliance.tsx's current string-match filter; this timestamp
  // makes a real predicate possible later without breaking that filter.
  redactedAt DateTime?

  // Set when a lead is created from the unauthenticated /companion flow
  // with no session cookie — see the migration plan's §"companion tenant
  // problem" for why this exists and what it's a deliberate tradeoff for.
  source String @default("dashboard")

  // Plain string ref (same convention as packId/itemName above, not a
  // relation) to the brochure microsite this lead was captured from, if any.
  brochureId String?

  dealRooms DealRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, followUpAt])
}

// A property listing's shareable microsite. Listings themselves have no DB
// row (see core/industries/*.ts) — packId/itemId is a plain string pair
// resolved live against the shipped pack config at request time, the same
// convention Lead.packId/itemName already uses. That's what makes "listing
// edits reflect on the microsite instantly" true for free: the microsite
// re-resolves the item on every request instead of storing a copy of it.
model Brochure {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  packId String
  itemId String

  // The microsite's own URL segment (/b/[slug]) — this *is* the permanent
  // short link; there's no separate redirect layer.
  slug String @unique

  template BrochureTemplate @default(Modern)
  theme    BrochureTheme    @default(Light)

  // Ordered widget composition: [{ id, type, enabled, order, config }].
  sections          Json
  brandingOverrides Json?

  status      BrochureStatus @default(Draft)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BrochureEvent[]
  assets BrochureAsset[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// Document Center attachment (floor plans, spec sheets, title-deed samples,
// etc). No object storage is configured for this app, so bytes are stored
// directly in Postgres — fine at modest volume, worth moving to real object
// storage (S3/Vercel Blob) once usage justifies it.
model BrochureAsset {
  id         String   @id @default(cuid())
  brochureId String
  brochure   Brochure @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([brochureId])
}

// Real analytics events (view/scan/click/lead) — no fabricated counts.
model BrochureEvent {
  id         String            @id @default(cuid())
  brochureId String
  brochure   Brochure          @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       BrochureEventKind
  meta       Json?
  createdAt  DateTime          @default(now())

  @@index([brochureId, createdAt(sort: Desc)])
  @@index([brochureId, kind])
}

// ---------------------------------------------------------------------
// Deal Room & Template Engine — generalizes the Brochure module above into
// a reusable, versioned, industry-agnostic template system. A
// DealRoomTemplate is edited/versioned/published independently of any
// specific deal; a DealRoom is an instance created from a template for a
// real customer/lead, frozen to the template version it was built from so
// a live negotiation never silently reflows when the master template is
// edited later. Nothing here is industry-specific in code — "category" and
// "industry" are free text, and an industry's starter template is just a
// row with a chosen widget composition, same as core/industries/*.ts packs
// are config, not code, for the product's other engine.
// ---------------------------------------------------------------------

model DealRoomTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  category String // e.g. "Proposal", "Renewal", "Onboarding" — user-defined, unlimited
  industry String // e.g. "Insurance", "Real Estate" — user-defined, unlimited

  status DealRoomTemplateStatus @default(Draft)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions  DealRoomTemplateVersion[]
  dealRooms DealRoom[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// Immutable snapshot. Publishing or rolling back always creates a new row
// here rather than mutating an old one — that's what makes Compare/Rollback
// honest instead of just overwriting history.
model DealRoomTemplateVersion {
  id         String           @id @default(cuid())
  templateId String
  template   DealRoomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  version Int
  // Ordered widget composition — same shape as Brochure.sections:
  // [{ id, type, enabled, order, config }].
  sections Json
  theme    Json

  // At most one version per template has isCurrent = true — the version a
  // freshly-created DealRoom is instantiated from. Toggled in a transaction
  // (unset old, set new) rather than modeled as a circular FK pointer.
  isCurrent Boolean @default(false)

  authorId     String?
  author       User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  changeReason String  @default("")
  createdAt    DateTime @default(now())

  dealRooms DealRoom[]

  @@unique([templateId, version])
  @@index([templateId, isCurrent])
}

// The direct generalization of Brochure: a real, shareable instance
// created from a template for an actual deal. Like Brochure, any inventory
// item it references (packId/itemId) is a plain string pair resolved live
// against the shipped pack config, not a stored copy.
model DealRoom {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  templateId        String
  template          DealRoomTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersionId String
  templateVersion   DealRoomTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  // The room's own URL segment (/d/[slug]) — same "the link IS the
  // permanent short URL" convention as Brochure.slug.
  slug       String             @unique
  accessMode DealRoomAccessMode @default(PublicLink)
  // Set only when accessMode = Restricted — a capability-URL secret sent to
  // the specific recipient, same trust model as the unguessable slug itself,
  // not a login credential, so it isn't hashed.
  accessCode String?

  packId String?
  itemId String?
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Per-instance widget config overrides layered on top of the frozen
  // template version's sections (e.g. this room's own Financing Calculator
  // inputs) — same overlay idea as core/store/packs.ts's draft-over-shipped
  // pattern, just per-room instead of per-tenant.
  sectionOverrides Json?
  theme            DealRoomTheme?

  status      DealRoomStatus @default(Draft)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets            DealRoomAsset[]
  events            DealRoomEvent[]
  tasks             DealRoomTask[]
  messages          DealRoomMessage[]
  approvalSteps     DealRoomApprovalStep[]
  signatureRequests DealRoomSignatureRequest[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([templateId])
}

// Document Center attachment — same Postgres-blob storage tradeoff as
// BrochureAsset (no object storage configured; fine at modest volume).
model DealRoomAsset {
  id         String   @id @default(cuid())
  dealRoomId String
  dealRoom   DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([dealRoomId])
}

// Real analytics events only — no fabricated counts.
model DealRoomEvent {
  id         String            @id @default(cuid())
  dealRoomId String
  dealRoom   DealRoom          @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       DealRoomEventKind
  meta       Json?
  createdAt  DateTime          @default(now())

  @@index([dealRoomId, createdAt(sort: Desc)])
  @@index([dealRoomId, kind])
}

model DealRoomTask {
  id         String   @id @default(cuid())
  dealRoomId String
  dealRoom   DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title        String
  detail       String             @default("")
  status       DealRoomTaskStatus @default(Open)
  assignedToId String?
  assignedTo   User?              @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  dueAt        DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([dealRoomId])
}

// Persisted chat thread — real messages, real timestamps. Delivery is
// polling-based (no realtime/push provider configured), not fabricated.
model DealRoomMessage {
  id         String   @id @default(cuid())
  dealRoomId String
  dealRoom   DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Null when sent by the external customer through the public room (no
  // login there); set when sent by a tenant user from the dashboard side.
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([dealRoomId, createdAt])
}

model DealRoomApprovalStep {
  id         String   @id @default(cuid())
  dealRoomId String
  dealRoom   DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label      String
  order      Int
  status     DealRoomApprovalStepStatus @default(Pending)
  approverId String?
  approver   User?                      @relation(fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt  DateTime?
  note       String                     @default("")

  @@index([dealRoomId, order])
}

// A real click-to-sign audit record (typed name + timestamp + IP) — not a
// legally-binding e-signature. No vendor (DocuSign/HelloSign/Dropbox Sign/
// etc) is configured for this project; shown as "not connected" in the UI
// rather than faked, same disclosure pattern as Integrations.tsx.
model DealRoomSignatureRequest {
  id          String                  @id @default(cuid())
  dealRoomId  String
  dealRoom    DealRoom                @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  signerName  String
  signerEmail String
  status      DealRoomSignatureStatus @default(Requested)

  signedName  String?
  signedAt    DateTime?
  signedIp    String?
  createdAt   DateTime                @default(now())

  @@index([dealRoomId])
}

