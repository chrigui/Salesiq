// SalesIQ — persistent backend, Phase 1.
//
// Core models (Tenant, Branch, User, Session, RolePermission, Lead) are
// wired to real API routes this phase. Every other model below mirrors an
// existing localStorage-backed store in src/core/data/*.ts or
// src/core/store/*.ts and is a schema-only placeholder — present so the
// schema is holistic, not yet read/written by any route. See the migration
// plan for the phased rollout.
//
// Tenant-scoping convention applied throughout: every tenant-owned model
// carries `tenantId` + an index on it, and natural keys are composite
// (`@@unique([tenantId, x])`), never a bare global unique — the one thing
// the localStorage-only app never had to model, since it was effectively
// single-tenant per browser.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Core — wired this phase
// ---------------------------------------------------------------------

enum UserRole {
  Owner
  Admin
  Manager
  // Template Builder / Deal Room design role — can build and publish
  // DealRoomTemplates but isn't granted the broader Manager permission set.
  Designer
  Salesperson
  Viewer
}

enum UserStatus {
  active
  invited
  suspended
}

enum LeadStatus {
  new
  contacted
  qualified
  won
  lost
}

enum BrochureTemplate {
  Modern
  Luxury
  Minimal
}

enum BrochureTheme {
  Light
  Dark
  Auto
  Brand
}

enum BrochureStatus {
  Draft
  Published
  Archived
}

enum BrochureEventKind {
  View
  Scan
  Click
  LeadSubmitted
}

enum DisplayTemplate {
  Minimal
  NewDevelopment
  Detailed
  Lifestyle
  Investment
  LuxuryCinematic
  Cinematic
  Masterplan
  Custom
  Dashboard
}

enum DisplayProfileStatus {
  Draft
  Published
  Archived
}

// Stack = today's vertical scroll of full-width sections (unchanged default).
// Grid = a dense dashboard of simultaneously-visible widget cards.
enum DisplayProfileLayout {
  Stack
  Grid
}

enum DealRoomTemplateStatus {
  Draft
  Published
  Archived
}

enum DealRoomStatus {
  Draft
  Published
  Archived
}

enum DealRoomTheme {
  Light
  Dark
  Auto
  Brand
}

enum DealRoomAccessMode {
  PublicLink
  Restricted
}

enum DealRoomEventKind {
  View
  Scan
  Click
  WidgetInteraction
  Download
  Share
  ProposalAccepted
  TaskCompleted
  SignatureRequested
  SignatureSigned
}

enum DealRoomTaskStatus {
  Open
  InProgress
  Done
}

enum DealRoomApprovalStepStatus {
  Pending
  Approved
  Rejected
}

enum DealRoomSignatureStatus {
  Requested
  Signed
  Declined
}

model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  legalName       String   @default("")
  logoGlyph       String   @default("◈")
  logoUrl         String   @default("")
  tagline         String   @default("")
  defaultLanguage String   @default("en")
  defaultCurrency String   @default("USD")
  timezone        String   @default("UTC")
  address         String   @default("")
  workingHours    Json
  businessUnits   String[]

  // Platform-operator view (src/core/data/platformTenants.ts) — folded
  // into Tenant rather than a parallel table, so the admin console's
  // headline numbers and this row can never drift apart once wired.
  plan     String  @default("Starter")
  seats    Int     @default(1)
  mrr      Decimal @default(0) @db.Decimal(12, 2)
  health   String  @default("healthy")
  vertical String  @default("real-estate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches            Branch[]
  users               User[]
  sessions            Session[]
  rolePermissions     RolePermission[]
  leads               Lead[]
  brochures           Brochure[]
  brochureEvents      BrochureEvent[]
  brochureAssets      BrochureAsset[]
  inventoryItemAssets InventoryItemAsset[]

  displayProfiles        DisplayProfile[]
  displayProfileVersions DisplayProfileVersion[]
  displays               Display[]
  brandProfiles          BrandProfile[]
  displayProfileAssets   DisplayProfileAsset[]

  sharedExperiences      SharedExperience[]
  sharedExperienceEvents SharedExperienceEvent[]

  buyerProfiles           BuyerProfile[]
  buyerRequirementChanges BuyerRequirementChange[]
  buyerObjections         BuyerObjection[]
  buyerRejectedItems      BuyerRejectedItem[]
  buyerItemRelationships  BuyerItemRelationship[]
  buyerConversationNotes  BuyerConversationNote[]
  buyerActivityEvents     BuyerActivityEvent[]
  buyerSegments           BuyerSegment[]
  buyerNbaRules           BuyerNbaRule[]

  dealRoomTemplates         DealRoomTemplate[]
  dealRoomTemplateVersions  DealRoomTemplateVersion[]
  dealRooms                 DealRoom[]
  dealRoomAssets            DealRoomAsset[]
  dealRoomEvents            DealRoomEvent[]
  dealRoomTasks             DealRoomTask[]
  dealRoomMessages          DealRoomMessage[]
  dealRoomApprovalSteps     DealRoomApprovalStep[]
  dealRoomSignatureRequests DealRoomSignatureRequest[]

  /// TODO(pass-2): src/core/data/knowledgeBase.ts
  knowledgeEntries    KnowledgeEntry[]
  /// TODO(pass-2): src/core/data/tenantAuditLog.ts
  tenantAuditEntries  TenantAuditEntry[]
  /// TODO(pass-2): src/core/data/notifications.ts
  notifications       Notification[]
  /// TODO(pass-2): src/core/data/featureFlags.ts
  featureFlags        FeatureFlag[]
  /// TODO(pass-2): src/core/data/ssoSettings.ts
  ssoSettings         SsoSettings?
  /// TODO(pass-2): src/core/data/aiSettingsShared.ts
  aiSettings          AiSettings?
  /// TODO(pass-2): src/core/data/integrations.ts
  integrationSettings IntegrationSettings?
  /// TODO(pass-2): src/core/data/billingSettings.ts
  billingSettings     BillingSettings?
  /// TODO(pass-2): src/core/data/subscription.ts
  subscription        Subscription?
  /// TODO(pass-2): src/core/data/customPacks.ts
  customPacks         CustomPack[]
  /// TODO(pass-2): src/core/store/packs.ts
  packDrafts          PackDraft[]

  @@index([slug])
}

model Branch {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String   @default("")
  lat          Float?
  lng          Float?
  phone        String   @default("")
  status       String   @default("active")
  workingHours Json
  teamSize     Int      @default(0)
  displays     Int      @default(0)
  companions   Int      @default(0)
  createdAt    DateTime @default(now())

  users          User[]
  leads          Lead[]
  // Named to avoid colliding with the `displays Int` counter field above,
  // which is a separate, pre-existing manual tally, not backed by real rows.
  displayDevices Display[]
  buyerProfiles  BuyerProfile[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         UserRole
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status       UserStatus @default(invited)
  // Toggle only — no TOTP secret yet, see the PILOT-MODE AUTH comment in
  // core/data/auth.ts for exactly what this does and doesn't secure.
  mfaEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  device       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions         Session[]
  assignedLeads    Lead[]     @relation("LeadAssignee")
  createdLeads     Lead[]     @relation("LeadCreator")
  createdBrochures Brochure[]

  createdDisplayProfiles         DisplayProfile[]
  authoredDisplayProfileVersions DisplayProfileVersion[]
  createdDisplays                Display[]
  createdBrandProfiles           BrandProfile[]
  createdSharedExperiences       SharedExperience[]

  assignedBuyerProfiles         BuyerProfile[]
  createdBuyerConversationNotes BuyerConversationNote[]
  createdBuyerSegments          BuyerSegment[]

  createdDealRoomTemplates DealRoomTemplate[]
  authoredDealRoomVersions DealRoomTemplateVersion[]
  createdDealRooms         DealRoom[]
  assignedDealRoomTasks    DealRoomTask[]
  dealRoomMessages         DealRoomMessage[]
  dealRoomApprovalSteps    DealRoomApprovalStep[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

model Session {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         UserRole
  capabilityId String
  granted      Boolean

  @@unique([tenantId, role, capabilityId])
  @@index([tenantId, role])
}

model Lead {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name  String
  phone String @default("")
  email String @default("")
  notes String @default("")

  packId    String
  packLabel String
  itemName  String
  price     Decimal @db.Decimal(14, 2)
  currency  String  @db.Char(3)
  score     Int

  status       LeadStatus @default(new)
  assignedToId String?
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?      @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  followUpAt DateTime?
  // GDPR redact (src/core/store/leads.ts redactLeadPII) still writes the
  // literal string "Redacted" to `name` for compatibility with
  // SecurityCompliance.tsx's current string-match filter; this timestamp
  // makes a real predicate possible later without breaking that filter.
  redactedAt DateTime?

  // Set when a lead is created from the unauthenticated /companion flow
  // with no session cookie — see the migration plan's §"companion tenant
  // problem" for why this exists and what it's a deliberate tradeoff for.
  source String @default("dashboard")

  // Plain string ref (same convention as packId/itemName above, not a
  // relation) to the brochure microsite this lead was captured from, if any.
  brochureId String?

  // Plain string ref to the Display Studio kiosk this lead was captured
  // from, if any — same convention as brochureId.
  displayId String?

  // Real relation (not a plain string ref like brochureId/displayId above)
  // to the Buyer Intelligence identity this lead resolved/linked to, when
  // contact info matched — see BuyerProfile below.
  buyerProfileId String?
  buyerProfile   BuyerProfile? @relation(fields: [buyerProfileId], references: [id], onDelete: SetNull)

  dealRooms DealRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, followUpAt])
  @@index([tenantId, buyerProfileId])
}

// ---------------------------------------------------------------------
// Buyer Intelligence — "the SalesIQ Buyer Brain." A continuously-evolving,
// private per-buyer profile that persists across sessions, in contrast to
// Lead (a flat, disconnected fact table today — every capture creates a new
// row with no linkage back to a prior one) and to the live Companion
// session (src/core/store/session.ts, pure in-memory, gone on reset).
// Matched by normalized email/phone at capture time (see
// src/lib/buyerProfiles/match.ts) so the same person across multiple
// sessions/leads resolves to one profile instead of duplicating.
//
// PRIVACY: everything in this section is private salesperson/management
// intelligence. It must never be reachable from the public Brochure
// resolver, the Shared Experience resolver/DTO, or any field DisplayStage.tsx
// destructures from useSession() — see BI-PR6's verification pass.
// ---------------------------------------------------------------------
model BuyerProfile {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name              String
  email             String  @default("")
  phone             String  @default("")
  // Matching keys — lowercased/trimmed email, digits-only phone. Nullable
  // since a profile can exist with only one of the two contact channels.
  emailNormalized   String?
  phoneNormalized   String?
  preferredLanguage String?
  market            String?
  leadSource        String  @default("")

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // Every Json field below stores BuyerField<T>-wrapped values (see
  // src/core/buyerIntelligence/types.ts) — { value, provenance:
  // "explicit"|"inferred"|"observed", confidence?, evidence?, updatedAt }
  // — never a bare value, so provenance travels with the data itself.
  requirements Json?
  financial    Json?
  purposes     String[] // endUser | investment | secondHome | holidayHome | rental | business | other — multiple allowed
  motivations  Json? // [{ id, label, tier: "primary"|"secondary", evidence: string[] }]
  priorities   Json? // [{ requirement, importance: "must"|"important"|"preferred"|"nice"|"not_important" }]
  preferences  Json? // { property, location, financial, lifestyle, investment } — project-specific attribute keys

  intentLevel     String? // low | medium | high | very_high
  intentReasons   Json? // string[] — the explainability requirement: never a bare score
  intentUpdatedAt DateTime?

  purchaseReadiness           String? // Exploring|Researching|Shortlisting|Evaluating|Negotiating|DecisionReady|ReservationReady|Purchased
  purchaseReadinessConfidence Int? // 0-100
  purchaseReadinessSignals    Json? // string[]

  lastInteractionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leads              Lead[]
  requirementChanges BuyerRequirementChange[]
  objections         BuyerObjection[]
  rejectedItems      BuyerRejectedItem[]
  itemRelationships  BuyerItemRelationship[]
  conversationNotes  BuyerConversationNote[]
  activityEvents     BuyerActivityEvent[]

  @@index([tenantId])
  @@index([tenantId, emailNormalized])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, branchId])
  @@index([tenantId, assignedToId])
}

// Requirement-change history — never silently overwritten (spec §12).
model BuyerRequirementChange {
  id             String       @id @default(cuid())
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  field         String // e.g. "budget", "bedrooms"
  previousValue Json?
  newValue      Json?
  source        String // "sales-conversation" | "manual" | "questionnaire"

  createdAt DateTime @default(now())

  @@index([buyerProfileId, createdAt(sort: Desc)])
}

model BuyerObjection {
  id             String       @id @default(cuid())
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind       String // price | payment-plan | location | size | completion-date | financing | view | floor | amenities | investment-risk | legal | competitor | other
  confidence String // high | medium | low
  evidence   Json // string[]
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([buyerProfileId, createdAt(sort: Desc)])
}

model BuyerRejectedItem {
  id             String       @id @default(cuid())
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  packId       String
  itemId       String
  reason       String
  source       String // "sales-conversation" | "manual"
  // Salesperson override — a rejected item stays excluded from that buyer's
  // recommendations until this is set (spec §14).
  overriddenAt DateTime?

  createdAt DateTime @default(now())

  @@unique([buyerProfileId, packId, itemId])
}

// Append-only event log, not one row per (buyer,item) — the same item can
// pass through viewed -> shortlisted -> proposal_created over time and each
// transition is its own timestamped row (spec §15: "each state should have
// timestamps and relevant context").
model BuyerItemRelationship {
  id             String       @id @default(cuid())
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  packId  String
  itemId  String
  state   String // viewed|interested|saved|compared|shortlisted|recommended|rejected|proposal_created|proposal_viewed|negotiating|reserved|purchased|lost
  context Json?

  createdAt DateTime @default(now())

  @@index([buyerProfileId, packId, itemId])
  @@index([buyerProfileId, createdAt(sort: Desc)])
}

// Natural-language "describe the customer" capture — always goes through
// CONFIRM/EDIT/REJECT before anything is trusted as fact (spec §10).
model BuyerConversationNote {
  id             String       @id @default(cuid())
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rawText         String
  extracted       Json // structured candidate fields as returned by the extraction route
  status          String // pending | confirmed | edited | rejected
  confirmedFields Json? // final fields actually written, after any edit

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([buyerProfileId, createdAt(sort: Desc)])
}

// Behavioral tracking — begins once a live session is linked to a
// BuyerProfile (spec §5). Anonymous pre-identification activity is
// deliberately never retroactively attributed.
model BuyerActivityEvent {
  id             String       @id @default(cuid())
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind   String // property_viewed|repeat_view|floor_plan_opened|gallery_viewed|payment_plan_opened|comparison_made|proposal_opened|shared_experience_opened|return_visit|cta_click|appointment_requested|callback_requested|reservation_action|question_asked
  packId String?
  itemId String?
  meta   Json?

  createdAt DateTime @default(now())

  @@index([buyerProfileId, createdAt(sort: Desc)])
  @@index([buyerProfileId, kind])
}

// Wave 2 — a segment is a saved, declarative filter (criteria), never a
// stored membership snapshot: compileSegmentWhere(criteria) turns it into a
// live Prisma `where` at read time, so membership is always current and
// never goes stale as buyer state changes.
model BuyerSegment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  criteria Json // BuyerSegmentCriterion[] — see src/core/buyerIntelligence/segments.ts

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// Wave 2 — tenant-configurable Next Best Action rules. The Wave 1 hardcoded
// suggestNextBestAction() becomes the built-in fallback, checked only when
// no enabled rule matches, so a tenant that never touches this stays on
// byte-identical Wave 1 behavior. `conditions` reuses the existing
// Condition shape (src/core/types.ts), evaluated against a flat buyer-state
// record rather than question Answers — see src/core/buyerIntelligence/nbaRules.ts.
model BuyerNbaRule {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label      String
  priority   Int // lower evaluates first
  conditions Json // Condition[]
  suggestion String // template string, e.g. "Unresolved {topObjectionKind} objection — address it directly."
  enabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, priority])
}

// A property listing's shareable microsite. Listings themselves have no DB
// row (see core/industries/*.ts) — packId/itemId is a plain string pair
// resolved live against the shipped pack config at request time, the same
// convention Lead.packId/itemName already uses. That's what makes "listing
// edits reflect on the microsite instantly" true for free: the microsite
// re-resolves the item on every request instead of storing a copy of it.
model Brochure {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  packId String
  itemId String

  // The microsite's own URL segment (/b/[slug]) — this *is* the permanent
  // short link; there's no separate redirect layer.
  slug String @unique

  template BrochureTemplate @default(Modern)
  theme    BrochureTheme    @default(Light)

  // Ordered widget composition: [{ id, type, enabled, order, config }].
  sections          Json
  brandingOverrides Json?

  status      BrochureStatus @default(Draft)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BrochureEvent[]
  assets BrochureAsset[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// Document Center attachment (floor plans, spec sheets, title-deed samples,
// etc). No object storage is configured for this app, so bytes are stored
// directly in Postgres — fine at modest volume, worth moving to real object
// storage (S3/Vercel Blob) once usage justifies it.
model BrochureAsset {
  id         String   @id @default(cuid())
  brochureId String
  brochure   Brochure @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([brochureId])
}

// Extra files an admin attaches to a real-estate "project" — floor plans,
// payment plans, extra photos. Same no-object-storage-configured tradeoff as
// BrochureAsset (bytes live in Postgres). Keyed by (tenantId, packId, itemId)
// rather than a real foreign key: InventoryItem has no DB row of its own yet
// (the Inventory Builder still persists item fields to localStorage only —
// see src/lib/brochures/resolve.ts) — the same packId/itemId string-pair
// keying Brochure and DisplayProfile already use to reference an item.
model InventoryItemAsset {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packId   String
  itemId   String

  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([tenantId, packId, itemId])
}

// Real analytics events (view/scan/click/lead) — no fabricated counts.
model BrochureEvent {
  id         String            @id @default(cuid())
  brochureId String
  brochure   Brochure          @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       BrochureEventKind
  meta       Json?
  createdAt  DateTime          @default(now())

  @@index([brochureId, createdAt(sort: Desc)])
  @@index([brochureId, kind])
}

// ---------------------------------------------------------------------
// Display Studio — configuration for the Customer Display (the in-person,
// customer-facing screen), addressed the same way as Brochure/DealRoom
// (packId + itemId, resolved live against the shipped pack — never a
// stored copy). PR1 ships a pre-versioning shape (publish is a status
// flip, same as Brochure before Deal Room's versioning pattern was built);
// DisplayProfileVersion, BrandProfile, Display (the physical-kiosk
// registry) and SharedExperience land in later PRs of the same initiative.
// ---------------------------------------------------------------------

model DisplayProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Admin-facing label — a tenant may run several profiles per item.
  name String

  packId String
  itemId String

  template DisplayTemplate @default(Minimal)

  // Rendering shape for `sections` below — see DisplayProfileLayout doc
  // comment. Additive: existing profiles keep rendering as a stack.
  layout DisplayProfileLayout @default(Stack)

  // Reusable brand kit (see BrandProfile below), optional. Per-profile
  // brandOverrides layers on top of it when set. Resolution order the
  // renderer/editor apply: brandOverrides -> brandProfile -> pack branding.
  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  // Per-profile brand color overrides ({ brand, brandSoft } rgb triplets,
  // same convention as Branding.brand) — layered on top of brandProfile (or
  // the pack's own branding, when neither is set).
  brandOverrides Json?

  // Ordered widget composition: [{ id, type, enabled, order, config }] —
  // identical shape to Brochure.sections.
  sections Json

  // Motion/idle config — stored from PR1 onward so later PRs (preset
  // system, idle experience) are additive, not a schema change; inert
  // defaults until then.
  motion Json  @default("{\"preset\": \"Cinematic\"}")
  idle   Json?

  status      DisplayProfileStatus @default(Draft)
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displaysAsIdle Display[]               @relation("IdleProfile")
  displaysAsLive Display[]               @relation("LiveProfile")
  assets         DisplayProfileAsset[]
  versions       DisplayProfileVersion[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, packId, itemId])
}

// Immutable publish snapshot — DealRoomTemplateVersion's pattern, collapsed
// to profile-level (a DisplayProfile already plays the "one addressable
// unit" role DealRoomTemplate+DealRoom split into two). Publish and Revert
// both create a new row here rather than mutating an old one, which is what
// makes History/Revert honest instead of quietly overwriting the past. The
// live DisplayProfile row above stays the editable *draft*; the Customer
// Display and idle poll resolve against whichever version has isCurrent
// true, so a published listing never silently reflows mid-negotiation when
// someone keeps editing the draft afterward.
model DisplayProfileVersion {
  id        String         @id @default(cuid())
  profileId String
  profile   DisplayProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  version Int

  sections      Json
  motion        Json
  idle          Json?
  // Brand fully flattened at publish time ({ brand, brandSoft } rgb
  // triplets) — immune to a later edit or deletion of the attached
  // BrandProfile, unlike the live draft's brandProfileId/brandOverrides
  // resolution chain which is intentionally always-live.
  brandSnapshot Json?

  // At most one true per profileId, toggled inside a transaction on
  // publish/revert — never two, never zero once a profile has published at
  // least once.
  isCurrent Boolean @default(false)

  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  changeReason String   @default("")
  createdAt    DateTime @default(now())

  @@unique([profileId, version])
  @@index([profileId, isCurrent])
}

// Reusable brand kit, shareable across many DisplayProfiles — build once
// ("Green Hills Luxury"), attach to many. A profile's own brandOverrides
// still layers on top for one-off tweaks without forking the whole kit.
model BrandProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  // rgb triplet strings, e.g. "16 185 129" — same convention as
  // Branding.brand/brandSoft. Optional so a partial kit (just a logo, say)
  // is valid; the renderer falls back to pack branding for anything unset.
  brand       String?
  brandSoft   String?
  logoGlyph   String?
  // Theme-PR2: a real uploaded logo image, mirroring DisplayProfileAsset's
  // blob-storage tradeoff (no object storage configured for this app yet).
  // Nullable/paired so a kit with no logo uploaded stays valid — logoGlyph
  // above stays the emoji/text fallback when neither is set.
  logoData     Bytes?
  logoMimeType String?
  // fontHeading/fontBody store a curated font-option id (see
  // src/core/display/brandFonts.ts), validated server-side against that
  // allowlist on write — never a freeform font-family string.
  fontHeading String?
  fontBody    String?

  // Deep theming (Customer Display Experience, Theme-PR1). backgroundColor/
  // textColor stay nullable rgb-triplet strings like brand/brandSoft above
  // (unset = fall back to the app's default dark surface); the style enums
  // carry real defaults so an unthemed BrandProfile row still resolves to
  // today's exact look via resolveBrandTokens().
  backgroundColor     String?
  textColor           String?
  // Display Studio no-code control center: the rest of the semantic color
  // system (Primary/Accent are brand/brandSoft above; Background/Text are
  // backgroundColor/textColor above). Muted text and status colors are new
  // here — nullable rgb-triplet strings, same convention, falling back to
  // today's hardcoded neutrals/status colors when unset. "Surface" and
  // "Glass" from the spec aren't separate color fields: surfaceColor backs
  // a Solid cardStyle's flat background, and Glass is what cardStyle="Glass"
  // already means — a literal --glass color would just duplicate cardStyle.
  mutedTextColor      String?
  surfaceColor        String?
  successColor        String?
  warningColor        String?
  dangerColor         String?
  cardStyle           BrandCardStyle       @default(Glass)
  buttonStyle         BrandButtonStyle     @default(Filled)
  borderRadius        BrandBorderRadius    @default(Soft)
  shadowIntensity     BrandShadowIntensity @default(Elevated)
  spacingScale        BrandSpacingScale    @default(Comfortable)
  // Bounded typography controls (not independent heading/body scale sliders
  // — see plan's explicit scoping) applied to heading elements via
  // BrandTokenScope's --font-heading-weight/--letter-spacing-heading.
  headingWeight       BrandHeadingWeight   @default(Semibold)
  letterSpacing       BrandLetterSpacing   @default(Normal)
  defaultMotionPreset String?
  // Exactly one BrandProfile per tenant may be the whole-Display default
  // (Theme-PR3); enforced in application code (clear the others in the same
  // transaction), same convention as Published DisplayProfile resolution.
  isDefault           Boolean              @default(false)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profiles DisplayProfile[]

  @@index([tenantId])
}

enum BrandCardStyle {
  Glass
  Solid
  Outlined
}

enum BrandButtonStyle {
  Filled
  Outline
  Ghost
}

enum BrandBorderRadius {
  Sharp
  Soft
  Round
}

enum BrandShadowIntensity {
  Flat
  Subtle
  Elevated
}

enum BrandSpacingScale {
  Compact
  Comfortable
  Spacious
}

enum BrandHeadingWeight {
  Regular
  Medium
  Semibold
  Bold
}

enum BrandLetterSpacing {
  Tight
  Normal
  Wide
}

