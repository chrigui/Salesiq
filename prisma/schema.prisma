// SalesIQ — persistent backend, Phase 1.
//
// Core models (Tenant, Branch, User, Session, RolePermission, Lead) are
// wired to real API routes this phase. Every other model below mirrors an
// existing localStorage-backed store in src/core/data/*.ts or
// src/core/store/*.ts and is a schema-only placeholder — present so the
// schema is holistic, not yet read/written by any route. See the migration
// plan for the phased rollout.
//
// Tenant-scoping convention applied throughout: every tenant-owned model
// carries `tenantId` + an index on it, and natural keys are composite
// (`@@unique([tenantId, x])`), never a bare global unique — the one thing
// the localStorage-only app never had to model, since it was effectively
// single-tenant per browser.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Core — wired this phase
// ---------------------------------------------------------------------

enum UserRole {
  Owner
  Admin
  Manager
  Salesperson
  Viewer
}

enum UserStatus {
  active
  invited
  suspended
}

enum LeadStatus {
  new
  contacted
  qualified
  won
  lost
}

enum BrochureTemplate {
  Modern
  Luxury
  Minimal
}

enum BrochureTheme {
  Light
  Dark
  Auto
  Brand
}

enum BrochureStatus {
  Draft
  Published
  Archived
}

enum BrochureEventKind {
  View
  Scan
  Click
  LeadSubmitted
}

model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  legalName       String   @default("")
  logoGlyph       String   @default("◈")
  logoUrl         String   @default("")
  tagline         String   @default("")
  defaultLanguage String   @default("en")
  defaultCurrency String   @default("USD")
  timezone        String   @default("UTC")
  address         String   @default("")
  workingHours    Json
  businessUnits   String[]

  // Platform-operator view (src/core/data/platformTenants.ts) — folded
  // into Tenant rather than a parallel table, so the admin console's
  // headline numbers and this row can never drift apart once wired.
  plan     String @default("Starter")
  seats    Int    @default(1)
  mrr      Decimal @default(0) @db.Decimal(12, 2)
  health   String @default("healthy")
  vertical String @default("real-estate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches        Branch[]
  users           User[]
  sessions        Session[]
  rolePermissions RolePermission[]
  leads           Lead[]
  brochures       Brochure[]
  brochureEvents  BrochureEvent[]
  brochureAssets  BrochureAsset[]

  /// TODO(pass-2): src/core/data/knowledgeBase.ts
  knowledgeEntries KnowledgeEntry[]
  /// TODO(pass-2): src/core/data/tenantAuditLog.ts
  tenantAuditEntries TenantAuditEntry[]
  /// TODO(pass-2): src/core/data/notifications.ts
  notifications Notification[]
  /// TODO(pass-2): src/core/data/featureFlags.ts
  featureFlags FeatureFlag[]
  /// TODO(pass-2): src/core/data/ssoSettings.ts
  ssoSettings SsoSettings?
  /// TODO(pass-2): src/core/data/aiSettingsShared.ts
  aiSettings AiSettings?
  /// TODO(pass-2): src/core/data/integrations.ts
  integrationSettings IntegrationSettings?
  /// TODO(pass-2): src/core/data/billingSettings.ts
  billingSettings BillingSettings?
  /// TODO(pass-2): src/core/data/subscription.ts
  subscription Subscription?
  /// TODO(pass-2): src/core/data/customPacks.ts
  customPacks CustomPack[]
  /// TODO(pass-2): src/core/store/packs.ts
  packDrafts PackDraft[]

  @@index([slug])
}

model Branch {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String   @default("")
  lat          Float?
  lng          Float?
  phone        String   @default("")
  status       String   @default("active")
  workingHours Json
  teamSize     Int      @default(0)
  displays     Int      @default(0)
  companions   Int      @default(0)
  createdAt    DateTime @default(now())

  users User[]
  leads Lead[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         UserRole
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status       UserStatus @default(invited)
  // Toggle only — no TOTP secret yet, see the PILOT-MODE AUTH comment in
  // core/data/auth.ts for exactly what this does and doesn't secure.
  mfaEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  device       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions      Session[]
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads  Lead[] @relation("LeadCreator")
  createdBrochures Brochure[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

model Session {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         UserRole
  capabilityId String
  granted      Boolean

  @@unique([tenantId, role, capabilityId])
  @@index([tenantId, role])
}

model Lead {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name  String
  phone String @default("")
  email String @default("")
  notes String @default("")

  packId    String
  packLabel String
  itemName  String
  price     Decimal @db.Decimal(14, 2)
  currency  String  @db.Char(3)
  score     Int

  status       LeadStatus @default(new)
  assignedToId String?
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?      @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  followUpAt DateTime?
  // GDPR redact (src/core/store/leads.ts redactLeadPII) still writes the
  // literal string "Redacted" to `name` for compatibility with
  // SecurityCompliance.tsx's current string-match filter; this timestamp
  // makes a real predicate possible later without breaking that filter.
  redactedAt DateTime?

  // Set when a lead is created from the unauthenticated /companion flow
  // with no session cookie — see the migration plan's §"companion tenant
  // problem" for why this exists and what it's a deliberate tradeoff for.
  source String @default("dashboard")

  // Plain string ref (same convention as packId/itemName above, not a
  // relation) to the brochure microsite this lead was captured from, if any.
  brochureId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, followUpAt])
}

// A property listing's shareable microsite. Listings themselves have no DB
// row (see core/industries/*.ts) — packId/itemId is a plain string pair
// resolved live against the shipped pack config at request time, the same
// convention Lead.packId/itemName already uses. That's what makes "listing
// edits reflect on the microsite instantly" true for free: the microsite
// re-resolves the item on every request instead of storing a copy of it.
model Brochure {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  packId String
  itemId String

  // The microsite's own URL segment (/b/[slug]) — this *is* the permanent
  // short link; there's no separate redirect layer.
  slug String @unique

  template BrochureTemplate @default(Modern)
  theme    BrochureTheme    @default(Light)

  // Ordered widget composition: [{ id, type, enabled, order, config }].
  sections          Json
  brandingOverrides Json?

  status      BrochureStatus @default(Draft)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BrochureEvent[]
  assets BrochureAsset[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// Document Center attachment (floor plans, spec sheets, title-deed samples,
// etc). No object storage is configured for this app, so bytes are stored
// directly in Postgres — fine at modest volume, worth moving to real object
// storage (S3/Vercel Blob) once usage justifies it.
model BrochureAsset {
  id         String   @id @default(cuid())
  brochureId String
  brochure   Brochure @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([brochureId])
}

// Real analytics events (view/scan/click/lead) — no fabricated counts.
model BrochureEvent {
  id         String            @id @default(cuid())
  brochureId String
  brochure   Brochure          @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       BrochureEventKind
  meta       Json?
  createdAt  DateTime          @default(now())

  @@index([brochureId, createdAt(sort: Desc)])
  @@index([brochureId, kind])
}

