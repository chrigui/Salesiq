# Postgres connection string. Local dev: see README / plan for provisioning
# the sandbox's Postgres 16 into salesiq_dev / salesiq_test databases.
DATABASE_URL="postgresql://salesiq:salesiq@localhost:5432/salesiq_dev?schema=public"

# HS256 signing key for session JWTs — required, fail fast if unset.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The single tenant this pilot deployment resolves to (unauthenticated
# writes, e.g. from /companion, land here).
DEFAULT_TENANT_SLUG="green-hills"

# Shows the demo-account quick-login chips on the login screen and enables
# GET /api/auth/demo-accounts. Must be "false" in production.
SHOW_DEMO_LOGINS="true"

# Pilot-mode MFA code — see the PILOT-MODE AUTH comment in core/data/auth.ts
# for exactly what this does and doesn't secure.
DEMO_MFA_CODE="000000"

# Password used by prisma/seed.ts for all seeded demo users.
SEED_DEMO_PASSWORD="demo1234"

# Gates POST /api/test/reset (Playwright test-DB isolation). Never enable
# outside CI/local test runs — this route truncates data.
ALLOW_TEST_RESET="false"

# Optional — enables live Claude-authored AI responses; every AI feature has
# a working deterministic fallback when this is unset.
ANTHROPIC_API_KEY=
